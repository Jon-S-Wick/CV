\section{Summary}
\begin{onecolentry}
	Molecular and computational biologist with experience in Western blots, PCR, sterile cell culture, and genomic analysis. Investigated RNA interference pathways in \textit{T. thermophila} and protein degradation pathways in \textit{C. elegans}. Seeking a laboratory technician position to apply molecular and computational skills to immunology and cancer research.
\end{onecolentry}

\section{Education}
\begin{twocolentry}{
		September 2023 -- June 2026}
	\textbf{B.S. Molecular and Cellular Biology}, Computer Science minor
\end{twocolentry}
Western Washington University -- Bellingham, WA

\begin{onecolentry}
	\begin{highlights}
		\item \textbf{GPA:} 3.5/4.0
		\item \textbf{Honors:} Outstanding Graduate, WWU Dept of Biology, 2026
		\item \textbf{Relevant Coursework:} Immunobiology, Advanced Cell and Molec Lab, Biochemistry, Genomic Data Analysis, Cellular and Molecular Biology, Microbiology, Biostatistics, Genetics, Organic Chemistry
	\end{highlights}
\end{onecolentry}

\section{Research Experience}

\begin{twocolentry}{
		June 2024 -- Present
	}
	\textbf{Undergraduate Researcher}, Lee Lab, WWU -- Bellingham, WA
\end{twocolentry}
\begin{onecolentry}
	\begin{highlights}
		\item Investigate small non-coding RNA roles in an RNAi pathway maintaining genome integrity in \textit{Tetrahymena thermophila} using wet lab (Western Blot, cell culture, aseptic technique) and computational approaches.
		\item Develop custom bioinformatics pipelines in Python and R for genome-wide sRNA biogenesis loci identification and differential expression analysis.
		\item Maintain live cell cultures under sterile conditions and perform protein analysis via Western Blot.
		\item Present findings at lab meetings, journal clubs, and WWU SURP poster sessions.
	\end{highlights}
\end{onecolentry}

\vspace{0.15 cm}

\begin{twocolentry}{
		Spring 2025
	}
	\textbf{Advanced Molecular and Cell Lab} -- BIOL 487, WWU
\end{twocolentry}
\begin{onecolentry}
	\begin{highlights}
		\item Investigated ER-associated protein degradation (ERAD) via E2 ubiquitin ligase \textit{ubc-6} in \textit{C. elegans}, a pathway relevant to protein quality control in cancer and neurodegeneration.
		\item Performed Western Blots, Reverse Transcriptase PCR, and endpoint PCR to quantify misfolded protein accumulation in \textit{ubc-6} knockout lines.
		\item Co-authored a poster at the Northwest Worm Meeting and co-wrote a micropublication.
		\item Maintained detailed electronic lab notebooks using Benchling.
	\end{highlights}
\end{onecolentry}

\vspace{0.15 cm}

\begin{twocolentry}{
		Winter 2025
	}
	\textbf{Genomic Data Analysis} -- BIOL 477, WWU
\end{twocolentry}
\begin{onecolentry}
	\begin{highlights}
		\item Conducted mRNA differential expression analysis on \textit{Tetrahymena thermophila} datasets using DESeq2.
		\item Processed genomic data in a Unix environment using Bash, Python, and HPC resources.
		\item Communicated findings through a written research paper and oral presentation.
	\end{highlights}
\end{onecolentry}

\vspace{0.15 cm}

\begin{twocolentry}{
		May 2022 -- December 2022
	}
	\textbf{Biotech Research Intern}, Rain Incubator -- Tacoma, WA
\end{twocolentry}
\begin{onecolentry}
	\begin{highlights}
		\item Designed and executed pilot PCR-based experiments for tracking European Green Crab migration.
		\item Gained foundational experience in hypothesis development, literature review, and experimental planning.
	\end{highlights}
\end{onecolentry}

