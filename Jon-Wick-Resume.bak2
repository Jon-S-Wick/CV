\section{Summary}
\begin{onecolentry}
Molecular and computational biologist experienced in Western blots, PCR, sterile cell culture, and bioinformatic genomic analysis. Seeking a laboratory technician position applying these skills to immunology and cancer research.
\end{onecolentry}

\section{Education}
\begin{twocolentry}{September 2023 -- June 2026}
	\textbf{B.S. Molecular and Cellular Biology}, Computer Science minor
\end{twocolentry}
Western Washington University -- Bellingham, WA \hfill GPA: 3.5/4.0, Outstanding Graduate, WWU Dept of Biology 2026\\
\textit{Relevant coursework:} Immunobiology, Advanced Cell and Molec Lab, Biochemistry, Genomic Data Analysis, Cellular and Molecular Biology, Microbiology, Biostatistics, Genetics, Organic Chemistry

\section{Research Experience}

\begin{twocolentry}{June 2024 -- Present}
	\textbf{Undergraduate Researcher}, Lee Lab, WWU -- Bellingham, WA
\end{twocolentry}
\begin{onecolentry}
	\begin{highlights}
		\item Investigate small non-coding RNA roles in an RNAi pathway maintaining genome integrity in \textit{Tetrahymena thermophila} using Western Blot, cell culture, and bioinformatics.
		\item Develop custom pipelines in Python and R for genome-wide sRNA biogenesis loci identification and differential expression analysis.
		\item Present findings at lab meetings, journal clubs, and WWU SURP poster sessions.
	\end{highlights}
\end{onecolentry}

\vspace{0.08 cm}

\begin{twocolentry}{Spring 2025}
	\textbf{Advanced Molecular and Cell Lab} -- BIOL 487, WWU
\end{twocolentry}
\begin{onecolentry}
	\begin{highlights}
		\item Investigated ER-associated protein degradation (ERAD) via \textit{ubc-6} in \textit{C. elegans}, relevant to protein quality control in cancer and neurodegeneration.
		\item Performed Western Blots, RT-PCR, and endpoint PCR to quantify misfolded protein accumulation in \textit{ubc-6} knockout lines.
		\item Co-authored a poster at the Northwest Worm Meeting and co-wrote a micropublication.
	\end{highlights}
\end{onecolentry}

\vspace{0.08 cm}

\begin{twocolentry}{Winter 2025}
	\textbf{Genomic Data Analysis} -- BIOL 477, WWU
\end{twocolentry}
\begin{onecolentry}
	\begin{highlights}
		\item Conducted mRNA differential expression analysis on \textit{T. thermophila} datasets using DESeq2 in a Unix environment with Bash, Python, and HPC resources.
		\item Communicated findings through a written research paper and oral presentation.
	\end{highlights}
\end{onecolentry}

\vspace{0.08 cm}

\begin{twocolentry}{May 2022 -- December 2022}
	\textbf{Biotech Research Intern}, Rain Incubator -- Tacoma, WA
\end{twocolentry}
\begin{onecolentry}
	\begin{highlights}
		\item Designed and executed PCR-based experiments for tracking European Green Crab migration; gained experience in hypothesis development and experimental planning.
	\end{highlights}
\end{onecolentry}

