\section{Research Experience\secrule}




\begin{twocolentry}{
		June 2024 - present
	}
	\textbf{Undergraduate Researcher}, Lee Lab, WWU -- Bellingham, WA\end{twocolentry}

\begin{onecolentry}
	\begin{highlights}
		\item Investigated roles of small non-coding RNAs in an RNAi pathway maintaining genome integrity in \textit{Tetrahymena thermophila}, combining computational biology with molecular biology techniques (Western Blot, cell culture, aseptic technique).
		\item Developed custom bioinformatics pipelines in Python and R for genome-wide sRNA biogenesis loci identification and differential expression analysis.
		\item Maintained live cell cultures under sterile conditions and performed protein analysis via Western Blot to characterize RNAi pathway components.
		\item Presented findings at lab meetings, journal clubs, and the WWU SURP poster session.
		\item Prepared media, buffers, reagents, and performed lab duties for daily lab operations.
	\end{highlights}
\end{onecolentry}

\vspace{0.2 cm}

\begin{twocolentry}{
		Spring 2025
	}
	\textbf{Advanced Molecular and Cell w/lab} -- BIOL 487, WWU\end{twocolentry}

\begin{onecolentry}
	\begin{highlights}
		\item Investigated ER-associated protein degradation (ERAD) via E2 ubiquitin ligase \textit{ubc-6} in \textit{C. elegans}, a pathway directly relevant to protein quality control in cancer and neurodegeneration.
		\item Performed Western Blots, Reverse Transcriptase PCR, and endpoint PCR to quantify misfolded protein accumulation in \textit{ubc-6} knockout lines.
		\item Co-authored a poster presented at the Northwest Worm Meeting and co-wrote a micropublication on research findings.
		\item Maintained detailed electronic lab notebooks using Benchling.
	\end{highlights}
\end{onecolentry}

\vspace{0.2 cm}

\begin{twocolentry}{
		Winter 2025
	}
	\textbf{Genomic Data Analysis} -- BIOL 477, WWU\end{twocolentry}

\begin{onecolentry}
	\begin{highlights}
		\item Conducted mRNA differential expression analysis on \textit{Tetrahymena thermophila} datasets using DESeq2, identifying differentially expressed genes across experimental conditions.
		\item Processed and analyzed genomic data in a Unix environment using Bash, Python, and high-performance computing resources.
		\item Communicated findings through a written research paper and oral presentation.
	\end{highlights}
\end{onecolentry}

\vspace{0.2 cm}

\begin{samepage}
	\begin{twocolentry}{
			May 2022 - December 2022
		}
		\textbf{Biotech Research Intern}, Rain Incubator -- Tacoma, WA\end{twocolentry}
	\begin{onecolentry}
		\begin{highlights}
			\item Designed and executed pilot PCR-based experiments for tracking European Green Crab migration.
			\item Gained foundational experience including hypothesis development, literature review, and experimental planning.
		\end{highlights}
	\end{onecolentry}
\end{samepage}




